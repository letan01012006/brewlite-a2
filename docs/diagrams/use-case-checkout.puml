@startuml BrewLite_A2_UseCase_Checkout
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam usecase {
  BackgroundColor #F8FBFE
  BorderColor #417893
}

title BrewLite A2 - Sơ đồ use-case Đặt và thanh toán đơn hàng (MVP)

actor "Khách hàng\n(Customer)" as Customer

rectangle "BrewLite - Đặt và thanh toán đơn hàng (MVP)" {
  usecase "UC-06\nĐặt đơn hàng" as UC06
  usecase "UC-07\nThanh toán Ví/Thẻ mô phỏng" as UC07

  usecase "Tính lại giá ở máy chủ" as PRICE
  usecase "Kiểm tra đủ nguyên liệu" as STOCK
  usecase "Ghi nhận kết quả thanh toán" as RESULT

  usecase "UC-05\nĐăng nhập" as UC05
  usecase "Thử lại thanh toán" as RETRY
  usecase "Xử lý đơn PENDING quá hạn\n(15 phút)" as EXPIRE
}

Customer -- UC06
Customer -- UC07

UC06 ..> PRICE : <<include>>
UC06 ..> STOCK : <<include>>
UC07 ..> STOCK : <<include>>
UC07 ..> RESULT : <<include>>

UC05 ..> UC06 : <<extend>>\n(khi chưa xác thực)
RETRY ..> UC07 : <<extend>>\n(khi thanh toán thất bại)
EXPIRE ..> UC06 : <<extend>>\n(sau 15 phút chưa thanh toán)

note right of UC07
  - Chỉ hỗ trợ Ví/Thẻ mô phỏng (WALLET, CARD)
  - MockPaymentService nằm bên trong hệ thống
  - Barista tiếp nhận ở hậu điều kiện (đơn PAID)
end note

@enduml
