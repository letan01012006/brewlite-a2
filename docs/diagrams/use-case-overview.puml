@startuml BrewLite_A2_UseCase_Overview
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam usecase {
  BackgroundColor #F8FBFE
  BorderColor #417893
}
title BrewLite A2 - So do use-case tong quat (MVP)
actor "Khách hàng" as Customer
actor "Nhân viên quầy" as Barista
rectangle "BrewLite - phạm vi MVP" {
  usecase "UC-01\nXem menu" as UC01
  usecase "UC-02\nXem chi tiết / chọn size, topping" as UC02
  usecase "UC-03\nQuản lý giỏ hàng" as UC03
  usecase "UC-04\nĐăng ký và xác minh OTP" as UC04
  usecase "UC-05\nĐăng nhập" as UC05
  usecase "UC-06\nĐặt đơn hàng" as UC06
  usecase "UC-07\nThanh toán Ví/Thẻ mô phỏng" as UC07
  usecase "UC-08\nXem lịch sử đơn hàng" as UC08
  usecase "UC-09\nTheo dõi / xem chi tiết đơn" as UC09
  usecase "UC-10\nXem hàng đợi" as UC10
  usecase "UC-11\nCập nhật trạng thái" as UC11
  usecase "UC-12\nBàn giao đơn" as UC12
  usecase "Tính lại giá ở máy chủ" as PRICE
  usecase "Kiểm tra đủ nguyên liệu" as STOCK
  usecase "Ghi nhận kết quả thanh toán" as RESULT
}
Customer -- UC01
Customer -- UC02
Customer -- UC03
Customer -- UC04
Customer -- UC05
Customer -- UC06
Customer -- UC07
Customer -- UC08
Customer -- UC09
Barista -- UC10
Barista -- UC11
Barista -- UC12
UC06 ..> PRICE : <<include>>
UC06 ..> STOCK : <<include>>
UC07 ..> STOCK : <<include>>
UC07 ..> RESULT : <<include>>
@enduml
