@startuml BrewLite_A2_Deployment_Production
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam linetype ortho

title BrewLite A2 — UML Deployment Diagram (Local, CI/CD & Production)

node "Thiết bị Người dùng\n(Customer / Barista)" as ClientDevice {
  artifact "Trình duyệt Web\n(Mobile-first / Desktop)" as Browser
}

node "Môi trường Phát triển\n(Local Development)" as LocalEnv {
  node "Docker Compose (Local)" as LocalCompose {
    component "frontend (:3000)" as LocalWeb
    component "backend (:4000)" as LocalApi
    database "PostgreSQL 16 (:5432)\nVolume: brewlite_pgdata" as LocalDb
    LocalWeb -down-> LocalApi : HTTP /api/*
    LocalApi -down-> LocalDb : TCP 5432
  }
}

node "CI/CD & Container Registry\n(GitHub)" as GitHubEnv {
  artifact "GitHub Repository\n(letan01012006/brewlite-a2)" as GitRepo
  node "GitHub Actions Runner" as GHARunner {
    component "Workflow: ci.yml\n(Lint, Test, Build, Smoke Test)" as CIJob
    component "Workflow: cd.yml\n- Job publish (Build & Push GHCR)\n- Job deploy (Task 5.3 – kế hoạch, chưa có trong cd.yml)" as CDJob
  }
  node "GitHub Container Registry\n(ghcr.io)" as GHCR {
    artifact "ghcr.io/.../frontend\n(tag: latest, sha-<7 ký tự>)" as ImgWeb
    artifact "ghcr.io/.../backend\n(tag: latest, sha-<7 ký tự>)" as ImgApi
  }
  frame "GitHub Secrets & Tokens" as GHSecrets {
    artifact "GITHUB_TOKEN (github.token)\n[TÊN SECRET DEPLOY (chưa cấu hình)]" as SecretArtifacts
  }

  GitRepo -down-> CIJob : Push / PR to main
  CIJob -right-> CDJob : workflow_run (success)
  CDJob -down-> ImgWeb : docker push
  CDJob -down-> ImgApi : docker push
  GHSecrets .right.> CDJob : Inject tokens / secrets
}

node "Môi trường Production\n([NỀN TẢNG PRODUCTION])" as ProdEnv {
  node "Edge / Reverse Proxy / CDN (dự kiến)\n([DOMAIN PRODUCTION])" as EdgeProxy {
    component "HTTPS Termination (Port 443)\nRouting: / -> :3000 | /api/* -> :4000" as Router
  }

  node "Container Service: Frontend" as ProdWebNode {
    component "Next.js Standalone Server\n(apps/web — Port 3000)" as ProdWeb
    artifact "Env & Build-arg:\nBACKEND_API_URL=http://backend:4000/api\n(Đóng cứng lúc build trong cd.yml)\nPORT=3000, HOSTNAME=0.0.0.0" as WebEnv
    WebEnv .up.> ProdWeb
  }

  node "Container Service: Backend" as ProdApiNode {
    component "NestJS API Server\n(apps/api — Port 4000)\nEntrypoint: prisma migrate deploy" as ProdApi
    component "Health Check Endpoint\nGET /api/health" as HealthEp
    artifact "Secrets & Env:\nDATABASE_URL, JWT_SECRET,\nOTP_HASH_SECRET, PORT=4000,\nPAYMENT_MOCK_ENABLED=true\n(Bắt buộc để bật WALLET/CARD)" as ApiEnv
    ApiEnv .up.> ProdApi
    ProdApi -right- HealthEp
  }

  node "Database Service\n(Private Network — No Public IP)" as ProdDbNode {
    database "PostgreSQL 16\n(Port 5432)" as ProdDb
    storage "Persistent Storage\n(Persistent volume do [NỀN TẢNG PRODUCTION] quản lý)" as PgVolume
    ProdDb -down- PgVolume : Mount /var/lib/postgresql/data
  }

  component "Logging & Monitoring (dự kiến)\n([NỀN TẢNG PRODUCTION] Logs)" as ProdLogs

  Router -down-> ProdWeb : HTTP :3000 (Internal)
  Router -down-> ProdApi : HTTP :4000 (/api/*)
  ProdWeb -right-> ProdApi : Internal Rewrite\nhttp://backend:4000/api
  ProdApi -down-> ProdDb : TCP :5432 (SSL/Internal)
  ProdWeb .down.> ProdLogs : stdout / stderr
  ProdApi .down.> ProdLogs : stdout / stderr
}

Browser -down-> Router : HTTPS (Port 443)\nhttps://[DOMAIN PRODUCTION]
CDJob -down-> ProdEnv : Trigger Deploy (Kế hoạch Task 5.3)\n(Image tag: sha-<7 ký tự>)
ImgWeb .down.> ProdWebNode : docker pull
ImgApi .down.> ProdApiNode : docker pull
CDJob .down.> HealthEp : Post-deploy Smoke & Health Check (Kế hoạch)

@enduml
